{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/predict", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/features", "destination": "/api/index.py" },
    { "source": "/alerts", "destination": "/api/index.py" },
    { "source": "/", "destination": "/xai_ids_frontend/index.html" },
    { "source": "/(.*)", "destination": "/xai_ids_frontend/$1" }
  ],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
